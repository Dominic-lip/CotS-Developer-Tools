{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cots.local/schemas/tool-result.schema.json",
  "title": "CotS Tool Result",
  "type": "object",
  "required": ["success", "operation", "changed_objects", "warnings", "errors"],
  "properties": {
    "success": { "type": "boolean" },
    "status": { "type": "string", "enum": ["success", "failure", "preview"] },
    "operation_id": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "dry_run": { "type": "boolean", "default": false },
    "changed_objects": { "type": "array", "items": { "type": "string" } },
    "affected_object_paths": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "error_details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validation": { "type": "array", "items": { "type": "string" } },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "data": {}
  },
  "additionalProperties": true
}
